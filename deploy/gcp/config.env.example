# Resource identifiers only. Never put API keys in this file.
PROJECT_ID=your-project-id
REGION=us-central1
ZONE=us-central1-a
PREFIX=agentic-workbench
TAG=replace-with-unique-build-tag
CLARIFI_MODE=gemini
CLARIFI_API_MODEL=gemini-3.5-flash-lite
CLARIFI_API_KEY_SECRET=your-existing-secret:1
# For Vertex: CLARIFI_MODE=vertex and CLARIFI_GEMINI_MODEL=<available model ID>
CLARIFI_EVIDENCE_BUCKET=your-globally-unique-private-evidence-bucket
# Select an explicit release tag from https://github.com/ollama/ollama/releases.
OLLAMA_IMAGE=ollama/ollama:REPLACE_WITH_RELEASE_TAG
OLLAMA_MODEL=gemma3:4b
# Optional independent ClariFi model; benchmark latency on your VM before use.
# CLARIFI_LOCAL_MODEL=gemma4:12b-it-qat
MACHINE_TYPE=e2-standard-8
BOOT_DISK_GB=100
