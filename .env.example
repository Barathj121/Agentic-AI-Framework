AGENT_FRAMEWORK=google_adk
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# auto selects an installed Gemma tag, preferring the smallest installed variant.
# To pin a model, use the exact tag printed by ollama list (e.g. gemma3:4b).
OLLAMA_MODEL=auto
# Alternative: LLM_PROVIDER=openai_compatible for Bionic/LM Studio's local API.
# Copy the exact model ID from GET http://localhost:1234/v1/models into LLM_MODEL.
# Setup, server authentication and model choices: docs/MODELS-AND-DEBUGGING.md
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=
LLM_API_KEY=
LLM_STRUCTURED_MODE=json_schema
LLM_TEMPERATURE=0.1
# For a slow CPU model, consider 600 seconds.
LLM_TIMEOUT_SECONDS=180
# Optional independent ClariFi timeout. Takes precedence over LLM_TIMEOUT_SECONDS.
# If neither is configured, ClariFi uses 600 seconds per model request.
# CLARIFI_LLM_TIMEOUT_SECONDS=600
# Compatible servers must load the model with at least this context;
# this setting controls client budgeting, not the server's loaded context.
LLM_CONTEXT_TOKENS=8192
LLM_MAX_OUTPUT_TOKENS=4096
WORKSPACE_ROOT=./workspaces
MAX_UPLOAD_MB=100
SANDBOX_IMAGE=agentic-workbench-sandbox:latest
SANDBOX_CPUS=4
SANDBOX_MEMORY=8g
SANDBOX_TIMEOUT_SECONDS=300
MAX_REPAIR_ATTEMPTS=2
