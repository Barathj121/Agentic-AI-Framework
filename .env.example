LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# Alternative: LLM_PROVIDER=openai_compatible for Bionic/LM Studio's local API.
# Copy the exact model ID from GET http://localhost:1234/v1/models into LLM_MODEL.
# Setup, server authentication and model choices: docs/MODELS-AND-DEBUGGING.md
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=
LLM_API_KEY=
LLM_STRUCTURED_MODE=json_schema
LLM_TEMPERATURE=0.1
# For a slow CPU model, consider 600 seconds.
LLM_TIMEOUT_SECONDS=180
# Compatible servers must load the model with at least this context;
# this setting controls client budgeting, not the server's loaded context.
LLM_CONTEXT_TOKENS=8192
LLM_MAX_OUTPUT_TOKENS=4096
WORKSPACE_ROOT=./workspaces
MAX_UPLOAD_MB=100
SANDBOX_IMAGE=agentic-workbench-sandbox:latest
SANDBOX_CPUS=4
SANDBOX_MEMORY=8g
SANDBOX_TIMEOUT_SECONDS=300
MAX_REPAIR_ATTEMPTS=2
